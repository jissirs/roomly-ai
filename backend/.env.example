# Copy to .env and fill in real values. Never commit .env.

# "production" hides /docs and refuses to start with unsafe settings.
ENVIRONMENT=production

# Maintenance switch: false makes every AI route answer 503.
AI_ENABLED=true

# Per-user caps on paid AI calls (per server process).
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=200

# CORS: comma-separated origins allowed to call this API — your deployed site only
CORS_ORIGINS=https://your-site.example

# Supabase project — used to validate the access token frontend calls send.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# OpenAI API (https://platform.openai.com) — used for vision (detecting
# furniture in room photos), text reasoning (Object Decision scoring),
# and image generation (AI Generate step).
OPENAI_API_KEY=sk-your-openai-api-key

# Optional overrides — defaults in app/core/config.py already use the
# cheapest settings for each (gpt-4o-mini; gpt-image-1 at quality "low").
# OPENAI_IMAGE_MODEL=gpt-image-1.5   (gpt-image-1 is not available on every API key)
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=low
