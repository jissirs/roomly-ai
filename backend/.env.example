# Copy to .env and fill in real values. Never commit .env.

# CORS: comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:5190

# Supabase project — used to validate the access token frontend calls send.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret/service_role key (Project Settings > API). Server only — never put in frontend.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API (https://platform.openai.com) — used for vision (detecting
# furniture in room photos), text reasoning (Object Decision scoring),
# and image generation (AI Generate step).
OPENAI_API_KEY=sk-your-openai-api-key

# Optional overrides — defaults in app/core/config.py already use the
# cheapest settings for each (gpt-4o-mini; gpt-image-1 at quality "low").
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=low
